#include <stdio.h>
#include <stdlib.h>
#include <time.h> 

void NUKE()
{
    int *x, i = 1000000000, f = 1;
    while(i >= 1)
    {
        do
        {
            x = NULL;
            x = malloc(i * sizeof(int));
        }while(x != NULL);
        i /= 10;
        if(i == 1)
        {
            if(f = 1)
                i = 0;
            else
             f = 1;
        }
    }
}

int main ()
{
    srand(time(NULL));
    int x = rand() % 6 + 1;
    printf("%d", x);
    if(x < 6)
        printf(", lucky!\n");
    else
    {
        printf("..., GAME OVER, better luck next time!\n");
        NUKE();
    }
}